# Configuración SMTP para Nodemailer en Cloud Functions
# Para Gmail: Cuenta de Google -> Seguridad -> Verificación en dos pasos -> Contraseñas de aplicaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tokidev.learning@gmail.com
SMTP_PASS=tu_app_password_de_16_digitos
FROM_EMAIL=tokidev.learning@gmail.com
FROM_NAME=TokiDev Learning

# Webhook Secret de Lemon Squeezy
LEMON_SQUEEZY_WEBHOOK_SECRET=tu_webhook_secret_seguro
