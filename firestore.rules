rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para Notificaciones
    match /notifications/{notificationId} {
      // Permitir lectura a los usuarios autenticados dueños o administradores
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'ADMIN_ROLE'
      );

      // Permitir actualizar (ej. marcar como leída) a los destinatarios
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'ADMIN_ROLE'
      );

      // Permitir creación desde clientes autenticados
      allow create: if request.auth != null;

      // Permitir eliminar notificación al dueño
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'ADMIN_ROLE'
      );
    }

    // Reglas para Usuarios
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reglas para Cursos y Rutas
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /learningPaths/{pathId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if request.auth != null;

        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if request.auth != null;
        }
      }
    }

    // Matrículas y Progreso
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /lessonProgress/{progressId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Foros de Discusión
    match /discussions/{discussionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Postulaciones de Profesores
    match /instructorApplications/{applicationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Órdenes y Billeteras
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /instructor_wallets/{walletId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
