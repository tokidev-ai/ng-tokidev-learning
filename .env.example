# Firebase Configuration
# Copiá este archivo como .env y completá con los valores reales de Firebase Console:
# Firebase Console → Tu proyecto → ⚙️ Configuración → Tus apps → </> (Web) → firebaseConfig

NG_APP_FIREBASE_API_KEY=TU_API_KEY
NG_APP_FIREBASE_AUTH_DOMAIN=TU_PROJECT_ID.firebaseapp.com
NG_APP_FIREBASE_PROJECT_ID=TU_PROJECT_ID
NG_APP_FIREBASE_STORAGE_BUCKET=TU_PROJECT_ID.appspot.com
NG_APP_FIREBASE_MESSAGING_SENDER_ID=TU_SENDER_ID
NG_APP_FIREBASE_APP_ID=TU_APP_ID
NG_APP_FIREBASE_MEASUREMENT_ID=TU_MEASUREMENT_ID

# Lemon Squeezy Configuration (Pasarela Global)
# Panel Lemon Squeezy → Settings → API Keys / Webhooks / Stores
NG_APP_LEMON_SQUEEZY_STORE_ID=tu_store_id
NG_APP_LEMON_SQUEEZY_API_KEY=tu_api_key
NG_APP_LEMON_SQUEEZY_WEBHOOK_SECRET=tu_webhook_secret
NG_APP_LEMON_SQUEEZY_TEST_MODE=true

